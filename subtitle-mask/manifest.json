{
  "manifest_version": 3,
  "name": "Subtitle Mask",
  "version": "1.0",
  "description": "一键遮挡 bilibili / YouTube 视频下方的字幕",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "开关字幕遮挡 (Alt+S)" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+S" },
      "description": "开关字幕遮挡"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*", "*://*.youtube.com/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
