# 复制为 .env 后按需填写；密钥不要提交到仓库
DATABASE_URL=sqlite:///./data/app.db
MEDIA_DIR=./data/media
MEDIA_BASE_URL=/media

# Claude 选词（留空则使用离线规则选词）
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# 字节 seed-audio 语音（留空则浏览器朗读兜底，仅开发用）
VOLC_TTS_API_KEY=
TTS_MODEL=seed-audio-1.0
TTS_CONCURRENCY=8
TTS_SLOW_SPEECH_RATE=-25
VOICE_PROFILE="A warm, cheerful young {accent} female voice"

# 生图：placeholder（emoji 卡片）；正式服务商待定
IMAGE_PROVIDER=placeholder
