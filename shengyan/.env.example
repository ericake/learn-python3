# 复制为 .env 后填写。.env 已在 .gitignore 中，不要提交到仓库。

# 基础
DEFAULT_KEYWORDS=全嘻嘻            # 首次启动时自动创建的关键词组，多个用逗号分隔
PUBLIC_BASE_URL=http://localhost:8000
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/shengyan   # 默认使用本地 SQLite

# TikHub（小红书数据源）。必填，留空则不抓取数据。填好后可运行 python check_api.py 检查。
TIKHUB_API_KEY=
CRAWL_INTERVAL_MIN=10
CRAWL_MAX_PAGES=3
TIKHUB_MIN_INTERVAL_MS=1000
# CRAWLER_MODE=mock             # 只想看界面效果时用演示数据（不是真实数据）

# DeepSeek（情感判断）。留空则使用本地规则。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 邮件推送（选填）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
