# 复制为 .env 后填写。.env 已在 .gitignore 中，不要提交到仓库。

# 基础
APP_ENV=dev                      # dev：登录验证码直接显示在页面上；生产环境改为 prod
APP_SECRET_KEY=                  # 生产环境必填，至少 32 位随机字符串
ADMIN_PHONE=13800000000          # 首次启动时创建的管理员手机号
ADMIN_NAME=管理员
PUBLIC_BASE_URL=http://localhost:8000
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/shengyan   # 默认使用本地 SQLite

# TikHub（小红书数据源）。留空则使用演示数据。
TIKHUB_API_KEY=
CRAWL_INTERVAL_MIN=10
CRAWL_MAX_PAGES=3
TIKHUB_MIN_INTERVAL_MS=1000

# DeepSeek（情感判断）。留空则使用本地规则。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 邮件推送（选填）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
